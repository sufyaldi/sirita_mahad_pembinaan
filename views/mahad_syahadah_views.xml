<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mahad_syahadah_tree" model="ir.ui.view">
        <field name="name">mahad.syahadah.tree</field>
        <field name="model">mahad.syahadah</field>
        <field name="arch" type="xml">
            <list string="Sertifikat Kelulusan Ma'had (Syahadah)">
                <field name="name"/>
                <field name="student_id"/>
                <field name="nim"/>
                <field name="issue_date"/>
                <field name="academic_year"/>
                <field name="predikat"/>
                <field name="tahfizh_target_achieved"/>
                <field name="state" widget="badge" decoration-success="state == 'validated'" decoration-info="state == 'draft'" decoration-danger="state == 'cancelled'"/>
                <field name="is_unlocked_for_skripsi" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mahad_syahadah_form" model="ir.ui.view">
        <field name="name">mahad.syahadah.form</field>
        <field name="model">mahad.syahadah</field>
        <field name="arch" type="xml">
            <form string="Syahadah Kelulusan Ma'had">
                <header>
                    <button name="action_validate" string="Terbitkan / Luluskan" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="%(action_report_mahad_syahadah)d" string="Cetak Syahadah (PDF)" type="action" class="btn-primary" icon="fa-print"/>
                    <button name="action_cancel" string="Batalkan" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="nim"/>
                            <field name="faculty_prodi" readonly="state != 'draft'"/>
                            <field name="issue_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="academic_year"/>
                            <field name="predikat" readonly="state != 'draft'"/>
                            <field name="tahfizh_target_achieved" readonly="state != 'draft'"/>
                            <field name="is_unlocked_for_skripsi" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pengesahan &amp; Pejabat Penandatangan (TTE)">
                        <group>
                            <field name="signatory_id" readonly="state != 'draft'"/>
                            <field name="signatory_name" readonly="state != 'draft'"/>
                            <field name="signature_mode" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="signatory_nip" readonly="state != 'draft'"/>
                            <field name="signatory_job" readonly="state != 'draft'"/>
                            <field name="signatory_sk" readonly="state != 'draft'"/>
                            <field name="tte_token" readonly="1" invisible="not tte_token"/>
                            <field name="tte_datetime" readonly="1" invisible="not tte_datetime"/>
                        </group>
                    </group>
                    <group string="Nilai Kompetensi / Kemampuan">
                        <group>
                            <field name="score_quran" readonly="state != 'draft'"/>
                            <field name="score_surat_pendek" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="score_doa" readonly="state != 'draft'"/>
                            <field name="score_ibadah" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Keterangan Tambahan">
                        <field name="notes" placeholder="Catatan kelulusan..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mahad_syahadah" model="ir.actions.act_window">
        <field name="name">Sertifikat Syahadah Ma'had</field>
        <field name="res_model">mahad.syahadah</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

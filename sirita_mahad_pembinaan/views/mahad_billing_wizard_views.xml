<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mahad_billing_wizard_form" model="ir.ui.view">
        <field name="name">mahad.billing.wizard.form</field>
        <field name="model">mahad.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Generasi Tagihan Massal Ma'had (BLU VA)">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="building_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_invoices" string="Terbitkan Tagihan Massal" type="object" class="oe_highlight"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mahad_billing_wizard" model="ir.actions.act_window">
        <field name="name">Generasi Tagihan Massal (BLU)</field>
        <field name="res_model">mahad.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

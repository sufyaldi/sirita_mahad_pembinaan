<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kategori Pelanggaran -->
    <record id="view_mahad_penalty_category_tree" model="ir.ui.view">
        <field name="name">mahad.penalty.category.tree</field>
        <field name="model">mahad.penalty.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Pelanggaran Kedisiplinan">
                <field name="name"/>
                <field name="severity"/>
                <field name="default_points"/>
            </list>
        </field>
    </record>

    <record id="view_mahad_penalty_category_form" model="ir.ui.view">
        <field name="name">mahad.penalty.category.form</field>
        <field name="model">mahad.penalty.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Pelanggaran">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="default_points"/>
                        </group>
                    </group>
                    <group string="Rekomendasi Takzir Edukatif">
                        <field name="default_takzir" placeholder="Misal: Hafalan Surah Al-Mulk / Membersihkan Masjid..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mahad_penalty_category" model="ir.actions.act_window">
        <field name="name">Kategori Pelanggaran</field>
        <field name="res_model">mahad.penalty.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Record Pelanggaran & Takzir -->
    <record id="view_mahad_penalty_record_tree" model="ir.ui.view">
        <field name="name">mahad.penalty.record.tree</field>
        <field name="model">mahad.penalty.record</field>
        <field name="arch" type="xml">
            <list string="Catatan Pelanggaran Kedisiplinan">
                <field name="name"/>
                <field name="date"/>
                <field name="student_id"/>
                <field name="category_id"/>
                <field name="points"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_mahad_penalty_record_form" model="ir.ui.view">
        <field name="name">mahad.penalty.record.form</field>
        <field name="model">mahad.penalty.record</field>
        <field name="arch" type="xml">
            <form string="Record Pelanggaran &amp; Takzir">
                <header>
                    <button name="action_confirm" string="Konfirmasi Pelanggaran" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete_takzir" string="Tandai Takzir Selesai" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Batalkan" type="object" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="points" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Bentuk Takzir Edukatif (Tugas Perbaikan)">
                        <field name="takzir_note" placeholder="Instruksi tugas perbaikan / penugasan takzir..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mahad_penalty_record" model="ir.actions.act_window">
        <field name="name">Pelanggaran &amp; Takzir Mahasantri</field>
        <field name="res_model">mahad.penalty.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extension to Partner Form to show SP Status & Total Points -->
    <record id="view_partner_form_mahad_penalty" model="ir.ui.view">
        <field name="name">res.partner.form.mahad.penalty</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="total_penalty_points" readonly="1"/>
                <field name="sp_status" widget="badge" decoration-success="sp_status == 'aman'" decoration-warning="sp_status == 'sp1'" decoration-danger="sp_status in ('sp2', 'sp3')"/>
            </xpath>
        </field>
    </record>
</odoo>
